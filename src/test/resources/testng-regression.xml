<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CriarCenarioTestes - Regressão completa" verbose="1">
    <test name="Regressão - inclui cenários end-to-end dependentes de IA/Mongo/Jira">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="e2e"/>
            </run>
        </groups>
        <packages>
            <package name="workflow"/>
            <package name="cenario"/>
            <package name="jira"/>
            <package name="agent"/>
            <package name="autoqa"/>
            <package name="zephyr"/>
        </packages>
    </test>
</suite>
